NODE_ENV=development
PORT=3001
DATABASE_URL=mysql://constack:constack@localhost:3306/constack
REDIS_URL=redis://localhost:6379
CLUSTER_ID=in-cluster
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ORGANIZATION=ConStack
BOOTSTRAP_ADMIN_EMAIL=admin@constack.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
ACTIONS_ENABLED=false
AI_ENABLED=false
SECRET_METADATA_DISCOVERY_ENABLED=false
METRICS_ENABLED=true
DEMO_MODE=true
RESOURCE_HISTORY_RETENTION_DAYS=7
INCIDENT_RECOMMENDATION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
