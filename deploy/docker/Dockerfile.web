FROM node:24-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @constack/web... build

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN groupadd --system --gid 10001 constack && useradd --system --uid 10001 --gid constack --home-dir /app constack
WORKDIR /app
COPY --from=build --chown=constack:constack /workspace/apps/web/.next/standalone ./
COPY --from=build --chown=constack:constack /workspace/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=constack:constack /workspace/apps/web/public ./apps/web/public
# The standalone server runs with node directly; npm and Corepack are not
# required at runtime and their bundled dependency tree contains fixed CVEs.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
  /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
USER 10001
CMD ["node", "apps/web/server.js"]
